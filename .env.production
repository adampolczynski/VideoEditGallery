# Production Environment Variables
# ⚠️ Change all values from defaults!

# Server
PORT=5000
# NODE_ENV is set by the process manager or Docker runtime, not by Vite env files.

# API URL (change to your domain)
VITE_API_URL=https://your-domain.com

# 🔐 SECURITY: Generate strong values
# Use: openssl rand -hex 32
ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
JWT_SECRET=CHANGE_THIS_TO_STRONG_SECRET

# Storage
UPLOAD_DIR=./uploads
DATA_DIR=./data

# Optional: Nginx/Reverse Proxy
# DOMAIN=your-domain.com
# SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem
