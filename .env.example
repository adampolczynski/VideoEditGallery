# ⚠️ PRODUCTION CONFIGURATION - CHANGE THESE VALUES!

# Server Configuration
PORT=5000
# NODE_ENV is set by the process manager or Docker runtime, not by Vite env files.

# Frontend API URL (change to your domain)
VITE_API_URL=http://localhost:5000

# 🔐 SECURITY: Change these to strong random values!
# Generate with: openssl rand -hex 32
ADMIN_PASSWORD=change_this_to_a_strong_password
JWT_SECRET=change_this_to_a_strong_secret_key

# Data Storage
UPLOAD_DIR=./uploads
DATA_DIR=./data
